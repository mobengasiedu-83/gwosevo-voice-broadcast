APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 1: private AMI connection; dedicated account with minimum required permissions.
VITALPBX_AMI_HOST=
VITALPBX_AMI_PORT=5038
VITALPBX_AMI_USERNAME=
VITALPBX_AMI_SECRET=

# Populate only from recorded discovery evidence. Unknown limits block readiness.
VITALPBX_VERSION=
ASTERISK_VERSION=

# Exact PJSIP endpoint ID, which may differ from the VitalPBX display name.
VITALPBX_TRUNK_NAME=
VITALPBX_CALLER_ID=
# national: 0..., international: 233..., e164: +233...
VITALPBX_NUMBER_FORMAT=international
VITALPBX_DIAL_PATTERN=
VITALPBX_BROADCAST_CONTEXT=
VITALPBX_CARRIER_CHANNELS=
VITALPBX_CARRIER_CPS=
VITALPBX_RESERVED_CHANNELS=
VITALPBX_SAFE_PBX_CHANNELS=
VITALPBX_BROADCAST_CAP=
VITALPBX_DISCOVERY_EVIDENCE=

# Enable only after PBX dialplan/audio installation, carrier approval and controlled UAT.
VOICE_BROADCAST_ENABLED=false
VOICE_BROADCAST_GLOBAL_CHANNELS=0
VOICE_BROADCAST_GLOBAL_CPS=0

# Application-hosted recordings: PBX must reach this HTTP(S) base URL.
VOICE_BROADCAST_MEDIA_MODE=pbx
VOICE_BROADCAST_MEDIA_BASE_URL=

# Module 6 identity settings. Existing SMTP and TxtConnect credentials are reused.
CLIENT_REGISTRATION_ENABLED=true
CLIENT_REGISTRATION_AUTO_ACTIVATE=true
CLIENT_OTP_MINUTES=10
CLIENT_OTP_MAX_ATTEMPTS=5
CLIENT_TERMS_VERSION=2026-10-25
CLIENT_SMS_DRIVER=txtconnect
TXTCONNECT_API_URL=https://api.txtconnect.net/dev/api/sms/send
TXTCONNECT_API_TOKEN=
TXTCONNECT_SENDER_ID=
TXTCONNECT_UNICODE=0

# Cloudflare Turnstile: set real keys and allowed hostnames, then enable.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames, without scheme, path or port. Blank uses APP_URL host.
TURNSTILE_HOSTNAMES=
TURNSTILE_TIMEOUT=8

CLIENT_CHALLENGE_RETENTION_DAYS=7

MAIL_TIMEOUT=10

# Comma-separated names of explicitly validated high-precision CDR/CEL adapters. Empty holds rating.
CALL_RATING_TRUSTED_SOURCES=

# Maximum possible billable call in seconds; wallet holds ceil(seconds/60) billed minutes per attempt.
BILLING_MAX_CALL_SECONDS=900
# Answered calls charge the full recording length, rounded up to minutes, immediately; no provider CDR is required.
BILLING_INTERNAL_TIMING_SOURCE=engine

# Module 14 online top-ups. Disabled by default; do not enable before provider UAT.
PAYMENT_TOPUPS_ENABLED=false
PAYMENT_PROVIDER=xcel
PAYMENT_MIN_AMOUNT_MINOR=1000
PAYMENT_MAX_AMOUNT_MINOR=1000000
PAYMENT_PENDING_TTL_MINUTES=30
# Keep disabled until the Xcel contract is verified; http enables live initiation.
PAYMENT_XCEL_DRIVER=disabled
PAYMENT_XCEL_BASE_URL=
PAYMENT_XCEL_API_KEY=
PAYMENT_XCEL_INITIATE_PATH=/payments
PAYMENT_XCEL_HTTP_TIMEOUT=10
PAYMENT_XCEL_WEBHOOK_SECRET=
PAYMENT_XCEL_SIGNATURE_HEADER=X-Payment-Signature
PAYMENT_XCEL_TIMESTAMP_HEADER=X-Payment-Timestamp
PAYMENT_XCEL_WEBHOOK_TOLERANCE=300

# Module 16 personal account alerts. Email and SMS are queued; low-balance
# alerts are raised when available credit falls below one call's maximum hold
# unless a positive minor-unit threshold is set. The default window is daily.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_SMS_ENABLED=true
NOTIFICATIONS_LOW_BALANCE_MINOR=
NOTIFICATIONS_LOW_BALANCE_COOLDOWN_MINUTES=1440
NOTIFICATIONS_QUEUE=default


# Automatic stale hold cleanup. Set an internal billing.manage user before enabling.
BILLING_HOLD_CLEANUP_ENABLED=false
BILLING_HOLD_CLEANUP_ACTOR_ID=
BILLING_HOLD_CLEANUP_HOURS=24
BILLING_HOLD_CLEANUP_LIMIT=500

# Audio conversion executables must be available to PHP and queue workers.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Separate carrier expense based on actual answered call time (ceil minutes).
# Client campaign prices use the assigned client rate plan, not these values.
TELECOM_RATE_PER_MINUTE=0.30
TELECOM_CURRENCY=GHS
TELECOM_MINOR_UNIT_SCALE=2
