{
  "openapi": "3.0.3",
  "info": {
    "title": "VoiceCast Client API",
    "version": "1.0.0",
    "description": "Account-scoped integrations. Draft creation never starts calls. See ../step-12-integrations.md for operational and webhook contracts."
