      },
      "post": {
        "summary": "Create one way draft",
        "description": "Required scope: campaigns.write",
        "operationId": "create_one_way_draft",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,100}$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid, expired or revoked credential"
          },
          "403": {
            "description": "Missing scope or inactive account"
          },
          "404": {
            "description": "Record unavailable in account"
          },
          "409": {
            "description": "Idempotency conflict or expired key"
          },
          "413": {
            "description": "Request exceeds 1 MiB"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Quota exceeded"
          },
          "503": {
            "description": "API disabled"
          }
        },
        "x-required-scope": "campaigns.write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "purpose",
                  "source_group_id",
                  "audio_id",
                  "timezone",
                  "window_start",
                  "window_end",
                  "max_attempts",
                  "retry_delay_seconds"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "purpose": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "source_group_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "audio_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "timezone": {
                    "type": "string"
                  },
                  "window_start": {
                    "type": "string",
                    "pattern": "^[0-9]{2}:[0-9]{2}$"
                  },
                  "window_end": {
                    "type": "string",
                    "pattern": "^[0-9]{2}:[0-9]{2}$"
                  },
                  "max_attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "retry_delay_seconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 86400
                  },
                  "retry_outcomes": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "enum": [
                        "busy",
                        "no_answer",
                        "failed"
                      ]
                    }
                  },
                  "excluded_dates_text": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "expires_on": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        }
      }
    },
