    "/contact-imports": {
      "post": {
        "summary": "Stage contact import",
        "description": "Required scope: contacts.write",
        "operationId": "stage_contact_import",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,100}$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success"
          },
          "401": {
            "description": "Invalid, expired or revoked credential"
          },
          "403": {
            "description": "Missing scope or inactive account"
          },
          "404": {
            "description": "Record unavailable in account"
          },
          "409": {
            "description": "Idempotency conflict or expired key"
          },
          "413": {
            "description": "Request exceeds 1 MiB"
          },
          "422": {
            "description": "Validation failed"
          },
          "429": {
            "description": "Quota exceeded"
          },
          "503": {
            "description": "API disabled"
          }
        },
        "x-required-scope": "contacts.write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "group_id",
                  "rows"
                ],
                "properties": {
                  "group_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "required": [
                        "phone"
                      ],
                      "properties": {
                        "phone": {
                          "type": "string",
                          "maxLength": 40
                        },
                        "name": {
                          "type": "string",
                          "maxLength": 255
                        },
                        "source": {
                          "type": "string",
                          "maxLength": 255
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
